{
  "name": "feedback-kit-example-vite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:packages": "npm run build --prefix ../../packages/feedback-react && npm run build --prefix ../../packages/feedback-server",
    "dev": "npm run build:packages && node server.ts",
    "build": "npm run build:packages && vite build",
    "start": "NODE_ENV=production node server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@jbenet/feedback-react": "*",
    "@jbenet/feedback-server": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
