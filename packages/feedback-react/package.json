{
  "name": "@jbenet/feedback-react",
  "version": "0.1.0",
  "description": "The client of feedback-kit: a feedback button and keyboard shortcut, a sidebar with automatic and region screenshots, a WYSIWYG markdown field, per-page drafts, an offline outbox, and the issues pages. Extracted from Capital OS.",
  "license": "MIT",
  "author": "Juan Benet",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/build-package.mjs fix-dts dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-test-module-mocks test/*.test.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "modern-screenshot": "^4.7.0",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
